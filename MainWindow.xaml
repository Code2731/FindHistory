<Window x:Class="FindHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FindHistory.Localization"
        Title="FindHistory" Height="760" Width="1160"
        Icon="Assets/findhistory.ico"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FindHistory" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Translate '최근에 열었던 파일을 로컬 기록에서 바로 찾으세요'}"
                           Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D9A441" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitorHealthy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding MonitorStatusText}" Style="{StaticResource SecondaryText}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ComboBox Grid.Column="3" Width="112" VerticalContentAlignment="Center"
                      ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Label"
                      SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                      ToolTip="{loc:Translate '언어'}" />

            <Button Grid.Column="5" Content="{loc:Translate '진단'}" Style="{StaticResource QuietButton}"
                    Click="OnDiagnosticsClick" ToolTip="{loc:Translate '감시 상태와 로그 정보를 확인합니다'}" />

            <Button Grid.Column="7" Content="{loc:Translate '데이터 저장소'}" Click="OnDatabaseSettingsClick"
                    ToolTip="{loc:Translate '데이터베이스 위치를 이동하거나 기존 DB를 선택합니다'}" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="17" Padding="16,12,82,12" />
                    <TextBlock Text="{loc:Translate '파일명이나 경로 검색 (예: *.mp4)'}" FontSize="16"
                               IsHitTestVisible="False" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TertiaryText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#2A2A32" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="7,3"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Ctrl K" Style="{StaticResource TertiaryText}" FontSize="11" />
                    </Border>
                </Grid>

                <ComboBox Grid.Column="2" ItemsSource="{Binding DateRanges}"
                          SelectedItem="{Binding SelectedDateRange}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <DatePicker Grid.Column="4" Width="150"
                            SelectedDate="{Binding SpecificDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" ToolTip="{loc:Translate '조회할 날짜를 선택합니다'}">
                    <DatePicker.Style>
                        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpecificDateSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DatePicker.Style>
                </DatePicker>
                <Button Grid.Column="6" Content="{loc:Translate '새로고침'}" Command="{Binding RefreshCommand}" />
            </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="{loc:Translate '확장자'}" VerticalAlignment="Center" Margin="4,0,8,0"
                               Style="{StaticResource SecondaryText}" />
                    <TextBox Width="100" FontSize="12" Padding="10,7" MinHeight="36"
                             Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Translate '예: mp4, .pdf 또는 *.txt · 단일 확장자를 입력하세요'}" />
                    <ComboBox Width="180" Margin="10,0,0,0" MinHeight="36"
                              ItemsSource="{Binding ExistenceOptions}"
                              SelectedItem="{Binding SelectedExistence}" />
                    <Button Content="{loc:Translate '폴더 선택'}" Margin="10,0,0,0" Command="{Binding ChooseFolderCommand}"
                            ToolTip="{loc:Translate '선택한 폴더와 하위 폴더의 기록을 검색합니다'}" />
                    <Button Content="{loc:Translate '필터 초기화'}" Margin="10,0,0,0" Style="{StaticResource QuietButton}"
                            Command="{Binding ClearFiltersCommand}" />
                    <ComboBox Width="190" Margin="10,0,0,0" MinHeight="36"
                              ItemsSource="{Binding SavedSearches}"
                              SelectedItem="{Binding SelectedSavedSearch, Mode=TwoWay}"
                              ToolTip="{loc:Translate '저장한 검색 조건을 불러옵니다'}" />
                    <Button Content="{loc:Translate '검색 저장'}" Margin="8,0,0,0" Command="{Binding SaveSearchCommand}" />
                    <Button Content="{loc:Translate '선택 삭제'}" Margin="6,0,0,0" Style="{StaticResource QuietButton}"
                            Command="{Binding RemoveSavedSearchCommand}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding FilterChips}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" ToolTip="{Binding Label}"
                                    MaxWidth="650" Margin="0,6,6,0" Padding="10,5" MinHeight="28"
                                    FontSize="11" Background="{StaticResource AccentContainerBrush}"
                                    Command="{Binding DataContext.RemoveFilterCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,13">
            <Border.Resources>
                <Style x:Key="ActivityCellStyle" TargetType="Button"
                       BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="MinWidth" Value="14" />
                    <Setter Property="MinHeight" Value="14" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="Background" Value="#24242B" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ToolTipService.ShowDuration" Value="12000" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="1">
                            <Setter Property="Background" Value="#17384A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="2">
                            <Setter Property="Background" Value="#1E516A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="3">
                            <Setter Property="Background" Value="#28708F" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="4">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource SecondaryTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate '최근 활동'}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActivityPeriodText}" Style="{StaticResource SecondaryText}"
                               FontSize="11" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding ActivitySummaryText}" Style="{StaticResource TertiaryText}"
                               FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="{loc:Translate '날짜를 누르면 해당 기록만 표시합니다'}"
                               Style="{StaticResource TertiaryText}" FontSize="10" Margin="0,9,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate '월'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '화'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '수'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '목'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '금'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '토'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '일'}" Height="16" FontSize="9" Style="{StaticResource TertiaryText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl Grid.Column="2" ItemsSource="{Binding ActivityWeeks}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ActivityCellStyle}"
                                                IsEnabled="{Binding CanSelect}"
                                                ToolTip="{Binding ToolTipText}"
                                                AutomationProperties.Name="{Binding ToolTipText}"
                                                Command="{Binding DataContext.SelectActivityDateCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Translate '적음'}" Style="{StaticResource TertiaryText}"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Border Width="12" Height="12" CornerRadius="3" Background="#24242B" Margin="1" />
                    <Border Width="12" Height="12" CornerRadius="3" Background="#17384A" Margin="1" />
                    <Border Width="12" Height="12" CornerRadius="3" Background="#1E516A" Margin="1" />
                    <Border Width="12" Height="12" CornerRadius="3" Background="#28708F" Margin="1" />
                    <Border Width="12" Height="12" CornerRadius="3"
                            Background="{StaticResource AccentBrush}" Margin="1" />
                    <TextBlock Text="{loc:Translate '많음'}" Style="{StaticResource TertiaryText}"
                               FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate '최근 기록'}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <CheckBox Content="{loc:Translate '폴더별 보기'}" Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding FolderGroupingEnabled, Mode=TwoWay}"
                          ToolTip="{loc:Translate '현재 표시된 결과를 상위 폴더별로 묶습니다. 검색 조건과 내보내기 범위는 바꾸지 않습니다.'}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                       Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="8" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="ResultsGrid"
                          ItemsSource="{Binding ResultsView}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                          Background="Transparent" Foreground="{StaticResource TextBrush}"
                          BorderThickness="0" RowHeaderWidth="0" RowHeight="62"
                          ColumnHeaderHeight="38" MouseDoubleClick="OnResultDoubleClick"
                          HorizontalScrollBarVisibility="Disabled"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AccentContainerBrush}" Padding="14,8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}" FontSize="12"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='({0:N0})'}"
                                                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#143246" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="#143246" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="#F5F5F7" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                         Color="#F5F5F7" />
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentContainerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource AccentContainerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#131318" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Translate '파일'}" Width="4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TargetPath}" Margin="0,4,0,0" FontSize="11"
                                                   Style="{StaticResource TertiaryText}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Translate '종류'}" Binding="{Binding ItemKindText}" Width="84" />
                        <DataGridTextColumn Header="{loc:Translate '확장자'}" Binding="{Binding Extension}" Width="84" />
                        <DataGridTextColumn Header="{loc:Translate '마지막 기록'}" Binding="{Binding LastSeenText}" Width="150" />
                        <DataGridTextColumn Header="{loc:Translate '횟수'}" Binding="{Binding CountText}" Width="76" />
                        <DataGridTextColumn Header="{loc:Translate '상태'}" Binding="{Binding ExistsText}" Width="104" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate '검색 결과가 없습니다'}" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Translate '다른 파일명이나 경로로 검색해 보세요'}"
                               Style="{StaticResource SecondaryText}" Margin="0,7,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="{loc:Translate '위치 열기'}" Command="{Binding RevealCommand}" />
            <Button Grid.Column="3" Content="{loc:Translate '파일 열기'}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenCommand}" MinWidth="104" />
        </Grid>
    </Grid>
</Window>
