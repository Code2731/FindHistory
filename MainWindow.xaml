<Window x:Class="FindHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FindHistory" Height="760" Width="1160"
        Icon="Assets/findhistory.ico"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FindHistory" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="최근에 열었던 파일을 로컬 기록에서 바로 찾으세요"
                           Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="18" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="백그라운드 기록 중" Style="{StaticResource SecondaryText}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3" Content="데이터 저장소" Click="OnDatabaseSettingsClick"
                    ToolTip="데이터베이스 위치를 이동하거나 기존 DB를 선택합니다" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="17" Padding="16,12,82,12" />
                    <TextBlock Text="파일명이나 경로 검색 (예: *.mp4)" FontSize="16"
                               IsHitTestVisible="False" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TertiaryText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#2A2A32" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="7,3"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Ctrl K" Style="{StaticResource TertiaryText}" FontSize="11" />
                    </Border>
                </Grid>

                <ComboBox Grid.Column="2" ItemsSource="{Binding DateRanges}"
                          SelectedItem="{Binding SelectedDateRange}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <DatePicker Grid.Column="4" Width="150"
                            SelectedDate="{Binding SpecificDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" ToolTip="조회할 날짜를 선택합니다">
                    <DatePicker.Style>
                        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSpecificDateSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DatePicker.Style>
                </DatePicker>
                <Button Grid.Column="6" Content="새로고침" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="최근 기록" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SummaryText}"
                       Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="6" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" SelectionMode="Single"
                          Background="Transparent" Foreground="{StaticResource TextBrush}"
                          BorderThickness="0" RowHeaderWidth="0" RowHeight="62"
                          ColumnHeaderHeight="38" MouseDoubleClick="OnResultDoubleClick"
                          HorizontalScrollBarVisibility="Disabled"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentContainerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#131318" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="파일" Width="4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TargetPath}" Margin="0,4,0,0" FontSize="11"
                                                   Style="{StaticResource TertiaryText}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="종류" Binding="{Binding ItemKind}" Width="84" />
                        <DataGridTextColumn Header="확장자" Binding="{Binding Extension}" Width="84" />
                        <DataGridTextColumn Header="마지막 기록" Binding="{Binding LastSeenText}" Width="150" />
                        <DataGridTextColumn Header="횟수" Binding="{Binding CountText}" Width="76" />
                        <DataGridTextColumn Header="상태" Binding="{Binding ExistsText}" Width="104" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="검색 결과가 없습니다" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="다른 파일명이나 경로로 검색해 보세요"
                               Style="{StaticResource SecondaryText}" Margin="0,7,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="위치 열기" Command="{Binding RevealCommand}" />
            <Button Grid.Column="3" Content="파일 열기" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenCommand}" MinWidth="104" />
        </Grid>
    </Grid>
</Window>
