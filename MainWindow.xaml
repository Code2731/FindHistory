<Window x:Class="FindHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FindHistory" Height="760" Width="1180"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="FIND HISTORY" Foreground="{StaticResource AccentBrush}"
                           FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="지나간 파일을 다시 찾는 가장 빠른 방법"
                           FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" />
                <TextBlock Text="Windows 최근 항목을 내 PC에 계속 기록합니다."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <CheckBox Content="Windows 시작 시 백그라운드 실행"
                          IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
                <TextBlock Text="창을 닫아도 트레이에서 계속 기록됩니다"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="파일명이나 전체 경로를 입력하세요" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding DateRanges}"
                          SelectedItem="{Binding SelectedDateRange}" VerticalContentAlignment="Center" />
                <Button Grid.Column="4" Content="새로고침" Command="{Binding RefreshCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DatabasePath}"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" ToolTip="로컬 데이터베이스 위치" />
        </Grid>

        <Border Grid.Row="6" CornerRadius="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" SelectionMode="Single"
                      Background="Transparent" Foreground="{StaticResource TextBrush}"
                      BorderThickness="0" RowHeaderWidth="0" RowHeight="52"
                      ColumnHeaderHeight="38" MouseDoubleClick="OnResultDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0E1628" />
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="이름" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="경로" Binding="{Binding TargetPath}" Width="3*" />
                    <DataGridTextColumn Header="종류" Binding="{Binding ItemKind}" Width="80" />
                    <DataGridTextColumn Header="확장자" Binding="{Binding Extension}" Width="80" />
                    <DataGridTextColumn Header="마지막 기록" Binding="{Binding LastSeenText}" Width="145" />
                    <DataGridTextColumn Header="횟수" Binding="{Binding CountText}" Width="72" />
                    <DataGridTextColumn Header="상태" Binding="{Binding ExistsText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="위치 열기" Command="{Binding RevealCommand}" />
            <Button Grid.Column="3" Content="열기" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OpenCommand}" MinWidth="92" />
        </Grid>
    </Grid>
</Window>
