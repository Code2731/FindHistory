<Window x:Class="FindHistory.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FindHistory.Localization"
        Title="{loc:Translate '프로젝트 관리'}" Width="660" Height="570"
        MinWidth="540" MinHeight="500" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource PageBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Translate '프로젝트 관리'}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Translate '프로젝트마다 기준 폴더 하나를 지정합니다. 하위 폴더를 포함하며, 겹치면 더 깊은 폴더를 적용합니다.'}"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding Projects}"
                 SelectionChanged="OnProjectSelected" Margin="0,16,0,16"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" Padding="10,8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentContainerBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{loc:Translate '프로젝트 이름'}" Margin="0,0,0,6" />
            <TextBox x:Name="ProjectName" MaxLength="64" />
            <TextBlock Text="{loc:Translate '기준 폴더'}" Margin="0,10,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectFolder" IsReadOnly="True" />
                <Button Grid.Column="1" Content="{loc:Translate '폴더 선택'}" Click="OnChooseFolder" Margin="10,0,0,0" />
            </Grid>
            <TextBlock Text="{loc:Translate '새 프로젝트를 누르면 입력을 초기화합니다. 삭제해도 파일과 기록은 유지됩니다.'}"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Translate '새 프로젝트'}" Click="OnNewProject" Style="{StaticResource QuietButton}" />
                <Button Content="{loc:Translate '저장'}" Click="OnSaveProject" Margin="8,0,0,0" />
                <Button Content="{loc:Translate '삭제'}" Click="OnDeleteProject" Style="{StaticResource QuietButton}" Margin="8,0,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Translate '닫기'}" Click="OnClose" />
        </Grid>
    </Grid>
</Window>
