    <Window x:Class="FindHistory.StorageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FindHistory.Localization"
        Title="{loc:Translate '데이터 저장소'}" Width="640" Height="730"
        Icon="Assets/findhistory.ico"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Translate '데이터 저장소'}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Translate '기록을 보관할 위치를 바꾸거나 이전 DB를 다시 연결합니다.'}"
                       Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Translate '현재 데이터베이스'}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SecondaryText}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               ToolTip="{Binding DatabasePath}" />
                    <TextBlock Text="{Binding DatabaseSizeText}" Style="{StaticResource TertiaryText}"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Translate '폴더 열기'}" Style="{StaticResource QuietButton}"
                        Click="OnOpenFolderClick" Margin="14,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Translate '현재 DB 이동'}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{loc:Translate '기존 기록을 유지한 채 새 폴더로 파일을 옮깁니다.'}"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,6,0,0" />
                    <Button Grid.Row="3" Content="{loc:Translate '새 위치 선택'}" Style="{StaticResource PrimaryButton}"
                            Click="OnMoveDatabaseClick" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Translate '기존 DB 사용'}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{loc:Translate '다른 위치에 있는 FindHistory DB로 전환합니다.'}"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,6,0,0" />
                    <Button Grid.Row="3" Content="{loc:Translate 'DB 파일 선택'}" Click="OnUseDatabaseClick"
                            HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="#121F24" BorderBrush="#254350"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock Text="{loc:Translate '로컬 또는 외장 드라이브를 권장합니다. 실시간 동기화 폴더는 SQLite 파일 충돌을 만들 수 있습니다.'}"
                       Foreground="#A9D8E9" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Translate '백업 및 복원'}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Translate '복원 전 현재 DB도 안전 사본으로 보관합니다.'}"
                               Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,8,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Translate '백업 저장'}" Style="{StaticResource QuietButton}"
                        Click="OnBackupClick" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="{loc:Translate '백업 복원'}" Click="OnRestoreClick"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="10" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Translate '기록 내보내기'}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Translate '전체 기록과 개별 열기 이력을 파일로 저장합니다.'}"
                               Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,8,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Translate 'CSV 내보내기'}" Style="{StaticResource QuietButton}"
                        Click="OnExportCsvClick" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="{loc:Translate 'JSON 내보내기'}" Click="OnExportJsonClick"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="{loc:Translate '현재 검색 조건 전체를 내보냅니다. 표시 개수 제한은 없습니다. 날짜 선택 시 해당 기간의 열기 이력만 포함합니다. 항목 요약은 전체 기간 값입니다.'}"
                           Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,8,0"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" Content="{loc:Translate '현재 결과 CSV'}"
                        Style="{StaticResource QuietButton}" Click="OnExportResultsCsvClick"
                        VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="3" Content="{loc:Translate '현재 결과 JSON'}"
                        Click="OnExportResultsJsonClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,13">
            <StackPanel>
                <CheckBox Content="{loc:Translate '자동 백업 사용'}"
                          IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}" />
                <TextBlock Text="{loc:Translate '앱 실행 중 하루에 한 번 백업합니다. 설정 변경은 1분 이내에 적용됩니다.'}"
                           Style="{StaticResource SecondaryText}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Translate 'DB별 보관 개수'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding AutoBackupRetentionOptions}" Width="80"
                              SelectedItem="{Binding AutoBackupRetention, Mode=TwoWay}"
                              IsEnabled="{Binding AutoBackupEnabled}" />
                    <Button Content="{loc:Translate '폴더 열기'}" Style="{StaticResource QuietButton}"
                            Click="OnOpenAutoBackupFolderClick" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding AutoBackupDirectory}" Style="{StaticResource SecondaryText}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{loc:Translate '자동 백업만 정리합니다. 수동 백업과 복원 전 안전 사본은 유지합니다.'}"
                           Style="{StaticResource TertiaryText}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="14" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,13">
            <StackPanel>
                <TextBlock Text="{loc:Translate '저장 공간'}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StorageStatisticsText}" Style="{StaticResource SecondaryText}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{loc:Translate '조회 시점의 크기입니다. 백업 파일은 포함하지 않습니다. 빈 페이지 크기는 예상 회수량입니다.'}"
                           Style="{StaticResource TertiaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{loc:Translate '공간 정리는 기록을 삭제하지 않습니다. 작업 중 검색과 수집은 대기합니다. 추가 디스크 공간이 필요할 수 있습니다.'}"
                           Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Translate '다시 계산'}" Style="{StaticResource QuietButton}"
                            Click="OnRefreshStorageClick" />
                    <Button Content="{loc:Translate '공간 정리'}" Click="OnCompactClick" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="16">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,13" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{loc:Translate '기록 수집 설정'}" FontSize="14" FontWeight="SemiBold" />
                <Button Content="{Binding RecordingToggleText}" Command="{Binding ToggleRecordingCommand}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Translate '일시정지는 재시작 후에도 유지됩니다. 다시 시작하면 그 이후에 열린 항목부터 수집합니다.'}"
                           Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{loc:Translate '제외 폴더'}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="{loc:Translate '지정한 폴더와 하위 폴더의 새 기록을 제외합니다. 이미 저장된 기록은 계속 조회할 수 있습니다.'}"
                           Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                <ListBox x:Name="ExcludedFolderList" ItemsSource="{Binding ExcludedFolders}" MaxHeight="130"
                         MinHeight="52" Margin="0,8,0,0" Background="{StaticResource PageBrush}"
                         Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Padding" Value="6,4" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentContainerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Translate '제외 폴더 추가'}" Click="OnAddExcludedFolderClick" />
                    <Button Content="{loc:Translate '선택 해제'}" Click="OnRemoveExcludedFolderClick"
                            Style="{StaticResource QuietButton}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Content="{loc:Translate 'Windows 시작 시 백그라운드 실행'}"
                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="{loc:Translate '닫기'}" Click="OnCloseClick" MinWidth="82" />
        </Grid>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
