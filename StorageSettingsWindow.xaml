<Window x:Class="FindHistory.StorageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데이터 저장소" Width="640" Height="520"
        Icon="Assets/findhistory.ico"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="데이터 저장소" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="기록을 보관할 위치를 바꾸거나 이전 DB를 다시 연결합니다."
                       Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="현재 데이터베이스" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SecondaryText}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               ToolTip="{Binding DatabasePath}" />
                    <TextBlock Text="{Binding DatabaseSizeText}" Style="{StaticResource TertiaryText}"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="폴더 열기" Style="{StaticResource QuietButton}"
                        Click="OnOpenFolderClick" Margin="14,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="현재 DB 이동" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="기존 기록을 유지한 채 새 폴더로 파일을 옮깁니다."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,6,0,0" />
                    <Button Grid.Row="3" Content="새 위치 선택" Style="{StaticResource PrimaryButton}"
                            Click="OnMoveDatabaseClick" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="기존 DB 사용" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="다른 위치에 있는 FindHistory DB로 전환합니다."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,6,0,0" />
                    <Button Grid.Row="3" Content="DB 파일 선택" Click="OnUseDatabaseClick"
                            HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="#121F24" BorderBrush="#254350"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock Text="로컬 또는 외장 드라이브를 권장합니다. 실시간 동기화 폴더는 SQLite 파일 충돌을 만들 수 있습니다."
                       Foreground="#A9D8E9" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Content="Windows 시작 시 백그라운드 실행"
                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="닫기" Click="OnCloseClick" MinWidth="82" />
        </Grid>
    </Grid>
</Window>
